{
  "name": "agy-mcp-server",
  "version": "0.1.0",
  "description": "MCP server wrapper for Antigravity CLI (agy) — lets Claude Code talk to the agy CLI",
  "main": "dist/index.js",
  "bin": {
    "agy-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "agy",
    "antigravity",
    "claude",
    "ai",
    "cli"
  ],
  "author": "Paitoon Arayasayjapong",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toonPt0473/agy-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/toonPt0473/agy-mcp-server/issues"
  },
  "homepage": "https://github.com/toonPt0473/agy-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "chalk": "^5.6.0",
    "node-pty": "^1.1.0",
    "strip-ansi": "^7.2.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
